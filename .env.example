# Forge environment variables
#
# Copy this file to `.env` and fill in values for local development.
# This file is checked in. Never commit a real `.env` with secrets.

# ----- Runtime -----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed by CORS.
# For local dev, include the web dev server (default :3000).
CORS_ALLOW_ORIGINS=http://localhost:3000

# ----- Web -----
WEB_PORT=3000
# Public base URL the browser uses to reach the API.
# In local dev this is the API container/host on its exposed port.
API_BASE_URL=http://localhost:8000
# Browser-facing API URL (passed to client components as a prop).
# In Docker Compose the server uses API_BASE_URL=http://api:8000 while
# the laptop browser uses this value. Keep as localhost for local use.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ----- Database -----
# Use the postgres service from docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge

# ----- Worker -----
# Reserved for later phases. The Phase 0 worker does not consume these.
# WORKER_POLL_INTERVAL_SECONDS=5

# ----- Embeddings (Issue #004) -----
# fake = deterministic vectors, no network (default, CI-safe).
# openai = text-embedding-3-small (1536 dims) via OPENAI_API_KEY.
# gemini = gemini-embedding-001 (1536 dims, matches the column, no
#   migration) via a free Google AI Studio key (aistudio.google.com).
#   Keep FORGE_EMBEDDING_DIMENSION=1536 for gemini.
FORGE_EMBEDDING_PROVIDER=fake
# OPENAI_API_KEY= (shared with the LLM gateway; GEMINI_API_KEY,
# FORGE_GEMINI_API_KEY, or FORGE_EMBEDDING_API_KEY also accepted)
FORGE_EMBEDDING_MODEL=text-embedding-3-small
FORGE_EMBEDDING_DIMENSION=1536
FORGE_EMBEDDING_TIMEOUT_SECONDS=30.0

# ----- LLM (Issue #005) -----
# fake = canned schema-valid JSON, no network (default, CI-safe).
# openai = api.openai.com chat completions (strict JSON mode).
# opencode = OpenCode inference, OpenAI-compatible chat completions at
#   https://opencode.ai/inference/openai/v1 (needs an OpenCode key below).
# Any OpenAI-compatible gateway works via FORGE_LLM_BASE_URL
# ('/chat/completions' is appended). Strict JSON-schema mode is tried
# first; gateways that reject it fall back to plain-JSON mode.
FORGE_LLM_PROVIDER=fake
# API key for the LLM gateway: OPENAI_API_KEY, FORGE_OPENAI_API_KEY, or
# FORGE_LLM_API_KEY (an OpenCode service-account key for provider=opencode).
# OPENAI_API_KEY=
# Custom gateway root, e.g. a LiteLLM proxy or OpenCode Go
# (https://opencode.ai/zen/go/v1).
# FORGE_LLM_BASE_URL=
# Model ID the gateway expects. For opencode inference use one of its
# chat models, e.g. kimi-k2.5 (coding), glm-5, minimax-m2.5.
# FORGE_LLM_MODEL=kimi-k2.5
FORGE_LLM_MODEL=gpt-4o-mini
FORGE_LLM_TIMEOUT_SECONDS=30.0
FORGE_LLM_MAX_OUTPUT_TOKENS=1024

# ----- Auth (Issue #015) -----
# GitHub OAuth login. Absent → GitHub buttons return 503 AUTH_NOT_CONFIGURED.
# Local use needs no GitHub: the dashboard "Continue locally" form
# (POST /api/v1/auth/dev-login) works with just the dev secrets below.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Public redirect URI registered on the GitHub OAuth app.
FORGE_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# HS256 secret for session JWTs (24h) and Fernet key for tokens at rest.
# Dev defaults below are for LOCAL ONLY (never use in production).
# Generate fresh ones with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FORGE_JWT_SECRET=dev-only-change-me-5f6163aea7e9413bd3b8e28b97a8fe0a440c0ee7187f31cb1979fed423b7a087
FORGE_CREDENTIALS_KEY=V8G0Rbuyy1qK3TI5qZmSE82-M_C-iEj6-3MGXD2JwSY=
FORGE_JWT_EXPIRY_SECONDS=86400

# ----- Production (Issue #019) -----
# DOMAIN=forge.example.com (public hostname; Caddy auto-HTTPS)
# PUBLIC_URL=https://forge.example.com (CORS + smoke checks)
# DATABASE_URL=postgresql+asyncpg://... (managed Postgres + pgvector in prod)
# GRAFANA_ADMIN_PASSWORD= (Grafana admin for the prod stack)

# ----- Sandbox (Issue #017, worker) -----
# local = host subprocess (default); docker = ephemeral per-command containers.
FORGE_SANDBOX_BACKEND=local
FORGE_SANDBOX_IMAGE=forge-sandbox:0.1.0
FORGE_SANDBOX_CPUS=1.0
FORGE_SANDBOX_MEMORY_MB=512
FORGE_SANDBOX_PIDS_LIMIT=128
FORGE_SANDBOX_WORKSPACE_QUOTA_MB=512
FORGE_SANDBOX_NETWORK=none
# never = prod (digest-pinned, CI-built); missing/always for dev.
FORGE_SANDBOX_PULL_POLICY=never
# Run budgets (enforced by the Phase 5 worker loop; keys land now).
FORGE_RUN_MAX_SECONDS=1800
FORGE_RUN_MAX_COMMANDS=100
