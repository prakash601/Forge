# Forge environment variables
#
# Copy this file to `.env` and fill in values for local development.
# This file is checked in. Never commit a real `.env` with secrets.

# ----- Runtime -----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed by CORS.
# For local dev, include the web dev server (default :3000).
CORS_ALLOW_ORIGINS=http://localhost:3000

# ----- Web -----
WEB_PORT=3000
# Public base URL the browser uses to reach the API.
# In local dev this is the API container/host on its exposed port.
API_BASE_URL=http://localhost:8000

# ----- Database -----
# Use the postgres service from docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge

# ----- Worker -----
# Reserved for later phases. The Phase 0 worker does not consume these.
# WORKER_POLL_INTERVAL_SECONDS=5

# ----- Embeddings (Issue #004) -----
# fake = deterministic vectors, no network (default, CI-safe).
# openai = text-embedding-3-small (1536 dims) via OPENAI_API_KEY.
FORGE_EMBEDDING_PROVIDER=fake
# OPENAI_API_KEY=
FORGE_EMBEDDING_MODEL=text-embedding-3-small
FORGE_EMBEDDING_DIMENSION=1536
FORGE_EMBEDDING_TIMEOUT_SECONDS=30.0

# ----- LLM (Issue #005) -----
# fake = canned schema-valid JSON, no network (default, CI-safe).
# openai = gpt-4o-mini (gpt-4o override via FORGE_LLM_MODEL) via OPENAI_API_KEY.
FORGE_LLM_PROVIDER=fake
# OPENAI_API_KEY= (shared with embeddings; FORGE_OPENAI_API_KEY also accepted)
FORGE_LLM_MODEL=gpt-4o-mini
FORGE_LLM_TIMEOUT_SECONDS=30.0
FORGE_LLM_MAX_OUTPUT_TOKENS=1024
