# Forge environment variables
#
# Copy this file to `.env` and fill in values for local development.
# This file is checked in. Never commit a real `.env` with secrets.

# ----- Runtime -----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed by CORS.
# For local dev, include the web dev server (default :3000).
CORS_ALLOW_ORIGINS=http://localhost:3000

# ----- Web -----
WEB_PORT=3000
# Public base URL the browser uses to reach the API.
# In local dev this is the API container/host on its exposed port.
API_BASE_URL=http://localhost:8000

# ----- Database -----
# Use the postgres service from docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge

# ----- Worker -----
# Reserved for later phases. The Phase 0 worker does not consume these.
# WORKER_POLL_INTERVAL_SECONDS=5

# ----- Embeddings (Issue #004) -----
# fake = deterministic vectors, no network (default, CI-safe).
# openai = text-embedding-3-small (1536 dims) via OPENAI_API_KEY.
FORGE_EMBEDDING_PROVIDER=fake
# OPENAI_API_KEY=
FORGE_EMBEDDING_MODEL=text-embedding-3-small
FORGE_EMBEDDING_DIMENSION=1536
FORGE_EMBEDDING_TIMEOUT_SECONDS=30.0

# ----- LLM (Issue #005) -----
# fake = canned schema-valid JSON, no network (default, CI-safe).
# openai = gpt-4o-mini (gpt-4o override via FORGE_LLM_MODEL) via OPENAI_API_KEY.
FORGE_LLM_PROVIDER=fake
# OPENAI_API_KEY= (shared with embeddings; FORGE_OPENAI_API_KEY also accepted)
FORGE_LLM_MODEL=gpt-4o-mini
FORGE_LLM_TIMEOUT_SECONDS=30.0
FORGE_LLM_MAX_OUTPUT_TOKENS=1024

# ----- Auth (Issue #015) -----
# GitHub OAuth login. Absent → /auth/* returns 503 AUTH_NOT_CONFIGURED.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Public redirect URI registered on the GitHub OAuth app.
FORGE_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# HS256 secret for session JWTs (24h) and Fernet key for tokens at rest.
# Generate the latter with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FORGE_JWT_SECRET=
# FORGE_CREDENTIALS_KEY=
FORGE_JWT_EXPIRY_SECONDS=86400

# ----- Production (Issue #019) -----
# DOMAIN=forge.example.com (public hostname; Caddy auto-HTTPS)
# PUBLIC_URL=https://forge.example.com (CORS + smoke checks)
# DATABASE_URL=postgresql+asyncpg://... (managed Postgres + pgvector in prod)
# GRAFANA_ADMIN_PASSWORD= (Grafana admin for the prod stack)

# ----- Sandbox (Issue #017, worker) -----
# local = host subprocess (default); docker = ephemeral per-command containers.
FORGE_SANDBOX_BACKEND=local
FORGE_SANDBOX_IMAGE=forge-sandbox:0.1.0
FORGE_SANDBOX_CPUS=1.0
FORGE_SANDBOX_MEMORY_MB=512
FORGE_SANDBOX_PIDS_LIMIT=128
FORGE_SANDBOX_WORKSPACE_QUOTA_MB=512
FORGE_SANDBOX_NETWORK=none
# never = prod (digest-pinned, CI-built); missing/always for dev.
FORGE_SANDBOX_PULL_POLICY=never
# Run budgets (enforced by the Phase 5 worker loop; keys land now).
FORGE_RUN_MAX_SECONDS=1800
FORGE_RUN_MAX_COMMANDS=100
